-                </article>
-                <article>
-                  <span><span class="material-symbols-outlined">directions_bus</span></span>
-                  <strong data-i18n="guide.a4h">Muoversi</strong>
-                  <p data-i18n="guide.a4p">Info pratiche</p>
-                </article>
-              </div>
-              <div class="locked-tip">
-                <span><span class="material-symbols-outlined">lock</span></span>
-                <p data-i18n="guide.locked">La lista completa con mappe, consigli e itinerari viene condivisa dopo la prenotazione.</p>
-              </div>
+            <div class="guide-app guide-demo" id="guideDemo">
+              <noscript>Abilita JavaScript per esplorare la demo. La guida completa viene inviata agli ospiti.</noscript>
             </div>
           </div>
         </div>
@@ -677,5 +650,6 @@
   </div>
 
   <script src="script.js"></script>
+  <script src="guide-demo.js"></script>
 </body>
 </html>
diff --git a/style.css b/style.css
index 2a895f9..db4cc2f 100644
--- a/style.css
+++ b/style.css
@@ -1584,3 +1584,25 @@ main { width: 100%; margin: 0; padding: 0 0 70px; }
     padding: 10px;
   }
 }
+
+/* Interactive public guide preview */
+.guide-demo { height: 560px; overflow-y: auto; overscroll-behavior-y: contain; scrollbar-width: thin; }
+.guide-demo .guide-demo-notice { font-size: 11px; line-height: 1.5; color: var(--verde-dark); background: var(--verde-soft); padding: 10px; border-radius: 12px; margin: 12px 0; }
+.guide-demo .guide-demo-title { font-size: 30px; line-height: 1.15; margin: 16px 0 10px; }
+.guide-demo .guide-demo-intro { font-size: 12px; color: var(--muted); line-height: 1.6; }
+.guide-demo-category { font: inherit; text-align: left; background: #fff; color: var(--verde-dark); border: 1px solid rgba(58,90,64,.18); border-radius: 16px; padding: 14px; min-height: 112px; cursor: pointer; }
+.guide-demo-category:hover { background: var(--verde-soft); border-color: var(--verde); }
+.guide-demo-category small { display: flex; justify-content: space-between; font-size: 11px; margin-top: 8px; color: var(--muted); }
+.guide-demo-category small span { font-size: 15px; margin: 0; }
+.guide-demo-back { display: inline-flex; gap: 6px; align-items: center; font: inherit; font-size: 12px; color: var(--verde-dark); background: var(--verde-soft); border: 0; border-radius: 20px; padding: 9px 12px; cursor: pointer; }
+.guide-demo-back .material-symbols-outlined { font-size: 18px; }
+.guide-demo-cards { display: grid; gap: 10px; margin-top: 14px; }
+.guide-demo-card { background: #fff; border: 1px solid rgba(58,90,64,.14); border-radius: 16px; padding: 14px; }
+.guide-demo-meta { font-size: 10px; color: var(--muted); }
+.guide-demo-card h4 { font-size: 16px; line-height: 1.4; color: var(--verde-dark); margin: 6px 0; }
+.guide-demo-card p { font-size: 12px; line-height: 1.6; color: var(--muted); }
+.guide-demo button:focus-visible, #guideExplore:focus-visible { outline: 3px solid var(--verde-dark); outline-offset: 3px; }
+@media (max-width: 480px) {
+  .guide-demo { padding: 14px; height: 530px; }
+  .guide-demo-category { padding: 12px; min-height: 100px; }
+}
